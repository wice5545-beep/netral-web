DATABASE_URL="postgresql://postgres:password@localhost:5432/netral"
SESSION_SECRET="generate-a-32-char-secret-here"

# Supabase — requis pour l'auth Google OAuth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# URL publique de l'app (pour le redirect OAuth)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI providers
# NTRL 2.0 — OpenAI-compatible endpoint (glm-5.1)
NTRL_2_API_KEY="your-ntrl-2-api-key"
NTRL_2_API_KEY_FALLBACK="your-ntrl-2-fallback-key-1,your-ntrl-2-fallback-key-2"
MISTRAL_API_KEY="your-mistral-api-key"
MISTRAL_API_KEY_FALLBACK="your-mistral-fallback-key-1,your-mistral-fallback-key-2"
GROQ_API_KEY="your-groq-api-key"
CEREBRAS_API_KEY="your-cerebras-api-key"
GEMINI_API_KEY="your-gemini-api-key"
# NVIDIA_API_KEY="your-nvidia-api-key"  # deprecated

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Login / inscription avec Google
GOOGLE_AUTH_REDIRECT_URI="http://localhost:3000/api/auth/callback"
# Connexion Gmail, Calendar, Drive, Docs, Sheets depuis la page Intégrations
GOOGLE_INTEGRATIONS_REDIRECT_URI="http://localhost:3000/api/integrations/callback/google"

# Web search (optionnel — Tavily offre 1000 req/mois gratuit)
TAVILY_API_KEY="your-tavily-api-key"
# Jina AI Reader (optionnel — améliore la lecture des pages)
JINA_API_KEY="your-jina-api-key"